# --- Your own keys / credits. Only what your chosen provider needs. ---
# Local Ollama (default): nothing needed — leave everything commented.

# OpenAI-compatible APIs (OpenAI, OpenRouter, Together, Groq, ...).
# Set provider: openai_compatible + base_url in config/consistency_editor.yaml,
# then uncomment:
# OPENAI_API_KEY=sk-...

# Anthropic native API.
# Set provider: anthropic in config/consistency_editor.yaml, then uncomment:
# ANTHROPIC_API_KEY=sk-ant-...

# Gated Hugging Face downloads (only for fetching indic-parler-tts model).
# Get a token at https://huggingface.co/settings/tokens after requesting
# access at https://huggingface.co/ai4bharat/indic-parler-tts
# HF_TOKEN=hf_...
